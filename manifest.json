{
  "manifest_version": 3,
  "name": "Syklo Price Monitor & AutoTrader",
  "version": "1.0",
  "description": "Monitorea tasas P2P y ajusta órdenes automáticamente.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://webapp.syklo.io/*",
    "https://explorer.syklo.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://webapp.syklo.io/*",
        "https://explorer.syklo.io/*"
      ],
      "js": ["content.js", "autotrader.js"],
      "run_at": "document_idle"
    }
  ]
}
